# Google OAuth credentials / Google OAuth-данные
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# VPS callback URL / Callback URL на VPS
GOOGLE_REDIRECT_URI=https://YOUR_VPS_DOMAIN/gdrive/oauth/callback

# Server port / Порт сервера
PORT=3001
HOST=0.0.0.0
